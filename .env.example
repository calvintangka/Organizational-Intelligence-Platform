# =============================================================================
# OIP AI provider configuration
#
#   PRIMARY   DeepSeek API                       (data leaves the machine)
#   FALLBACK  Gemma 4 E4B via local LM Studio    (data stays on the machine)
#   FAIL-SAFE deterministic Organizational Intelligence (no external calls)
#
# Copy to .env.local and fill in real values. NEVER commit secrets.
# =============================================================================

# --- PRIMARY: DeepSeek API ----------------------------------------------------
# deepseek = DeepSeek → LM Studio → deterministic fallback.
# lmstudio = LM Studio → deterministic fallback.
# disabled = deterministic only.
# The API key is server-side only. Never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_AI_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000

# --- FALLBACK: local LM Studio -----------------------------------------------
# Each AI_* variable is also accepted with a NEXT_PUBLIC_ prefix
# (NEXT_PUBLIC_AI_MODE, NEXT_PUBLIC_AI_BASE_URL, NEXT_PUBLIC_AI_MODEL,
# NEXT_PUBLIC_AI_TIMEOUT_MS); either form works, the unprefixed form stays
# server-side only.
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=google/gemma-4-e4b
AI_TIMEOUT_MS=30000
# Set false/off when the operator intentionally disables local fallback.
AI_LMSTUDIO_ENABLED=true

# --- Persistence --------------------------------------------------------------
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/oip_development?schema=public
NEXT_PUBLIC_OIP_PERSISTENCE_MODE=server

# --- Rate limiting (RSS-1.2S2) -------------------------------------------------
# Abuse controls on login, AI proxies, tickets, jobs, connectors, governed
# actions, and administrative mutations. Counters are PostgreSQL-backed and
# shared across application instances. Never use a NEXT_PUBLIC_ prefix.
#
# RATE_LIMIT_MODE=enforce
#   enforce  = deny when a limit is exceeded (production-safe default)
#   observe  = count and report but do not deny
#   off      = disable (development only)
#
# RATE_LIMIT_HASH_SECRET=
#   Server-only key used to digest limiter dimensions (accounts, IPs, user ids,
#   organization ids) so raw values are never stored. REQUIRED in production
#   while RATE_LIMIT_MODE=enforce; a development fallback is used otherwise.
#   Rotating it resets existing counters.
#
# RATE_LIMIT_TRUST_PROXY=false
#   Only set true when every hop in front of the application is a trusted
#   reverse proxy that sets X-Forwarded-For. When false, x-real-ip is preferred
#   and, if absent, IP-based limits degrade to account/user/organization limits.
#
# Per-policy overrides (optional). Each policy accepts
# RATE_LIMIT_<POLICY_IN_UPPER_SNAKE>_MAX and _WINDOW_MS (milliseconds):
#   RATE_LIMIT_AUTH_LOGIN_ACCOUNT_MAX=10      # failed attempts per account
#   RATE_LIMIT_AUTH_LOGIN_IP_MAX=30           # failed attempts per address
#   RATE_LIMIT_AI_INVOKE_BURST_MAX=10         # per-user short burst
#   RATE_LIMIT_AI_INVOKE_USER_MAX=100         # per-user sustained window
#   RATE_LIMIT_AI_INVOKE_ORGANIZATION_MAX=500 # org-wide shared AI bucket
#   RATE_LIMIT_TICKET_SUBMIT_ORGANIZATION_MAX=500
#   RATE_LIMIT_JOB_CREATE_ORGANIZATION_MAX=200
#   RATE_LIMIT_CONNECTOR_MUTATE_ORGANIZATION_MAX=60
#   RATE_LIMIT_ADMIN_MUTATE_USER_MAX=50
#   RATE_LIMIT_EXPORT_FULL_ORGANIZATION_MAX=30
# Window overrides follow the same pattern, e.g.
#   RATE_LIMIT_AI_INVOKE_USER_WINDOW_MS=3600000

# Optional existing development user that receives idempotent membership when
# running organization foundation/fixture seed commands. The user must already
# exist; scripts never guess or hardcode a personal email.
# AUTH_DEVELOPMENT_USER_EMAIL=developer@example.test

# Optional server-adapter bootstrap override. Seeds the organization whose
# profile the server persistence adapter loads before the app selects an active
# organization. Leave unset to use the built-in default (profile-maesa-tech);
# every organization-scoped operation still passes its own id explicitly, so
# this only affects the initial profile load.
# NEXT_PUBLIC_OIP_ORGANIZATION_ID=profile-maesa-tech
