# =============================================================================
# OIP AI provider configuration
#
#   PRIMARY   Gemma 4 E4B via local LM Studio   (data stays on the machine)
#   FALLBACK  Claude API                         (data leaves the machine)
#   FAIL-SAFE deterministic Organizational Intelligence (no external calls)
#
# Copy to .env.local and fill in real values. NEVER commit secrets.
# =============================================================================

# --- PRIMARY: local LM Studio -------------------------------------------------
# lmstudio = run the AI chain; disabled = deterministic only.
# Each AI_* variable is also accepted with a NEXT_PUBLIC_ prefix
# (NEXT_PUBLIC_AI_MODE, NEXT_PUBLIC_AI_BASE_URL, NEXT_PUBLIC_AI_MODEL,
# NEXT_PUBLIC_AI_TIMEOUT_MS); either form works, the unprefixed form stays
# server-side only.
NEXT_PUBLIC_AI_MODE=lmstudio
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=google/gemma-4-e4b
AI_TIMEOUT_MS=30000

# --- FALLBACK: Claude API -----------------------------------------------------
# Server-side only (injected by /api/ai/claude). If ANTHROPIC_API_KEY is unset
# the proxy returns 503 and the chain falls through to the deterministic fail-safe.
# Create a key in the Anthropic Console. Never use a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_TIMEOUT_MS=30000

# --- Persistence --------------------------------------------------------------
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/oip_development?schema=public
NEXT_PUBLIC_OIP_PERSISTENCE_MODE=server

# Optional existing development user that receives idempotent membership when
# running organization foundation/fixture seed commands. The user must already
# exist; scripts never guess or hardcode a personal email.
# AUTH_DEVELOPMENT_USER_EMAIL=developer@example.test

# Optional server-adapter bootstrap override. Seeds the organization whose
# profile the server persistence adapter loads before the app selects an active
# organization. Leave unset to use the built-in default (profile-maesa-tech);
# every organization-scoped operation still passes its own id explicitly, so
# this only affects the initial profile load.
# NEXT_PUBLIC_OIP_ORGANIZATION_ID=profile-maesa-tech
