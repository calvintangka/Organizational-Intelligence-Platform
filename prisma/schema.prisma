generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KnowledgeLifecycleState {
  active
  candidate
  deprecated
}

enum KnowledgeCandidateLifecycle {
  proposed
  validated
  rejected
}

enum ValidationDecision {
  approved
  rejected
}

enum TicketRecordLifecycle {
  open
  in_review
  resolved
  rejected
  discarded
}

enum EmergingPatternLifecycle {
  monitoring
  suggested
  promoted
  dismissed
}

// TODO-026: durable auto-vs-human auditability. A completed resolution records
// whether a human had to resolve/approve the case. NULL means unresolved or a
// historical row whose mode was never captured — never silently "human".
enum TicketResolutionMode {
  human
  automatic
}

enum MigrationImportBatchStatus {
  pending
  validating
  ready
  importing
  partial
  conflict
  imported
  verifying
  verified
  failed
}

enum MigrationImportResourceType {
  knowledge
  knowledgeCandidates
  validationRecords
  memoryChangeRecords
  orgMetrics
  intelligenceLog
  emergingPatterns
  ticketRecords
  ticketSequence
}

enum MigrationImportResourceStatus {
  pending
  validating
  importing
  imported
  conflict
  failed
  verified
}

enum MigrationImportConflictType {
  same_id_different_content
  cross_organization_ownership_mismatch
  duplicate_candidate_validation
  duplicate_validation_memory_relationship
  ticket_id_collision
  lesson_id_content_conflict
  knowledge_version_id_conflict
  unresolved_historical_reference
  digest_mismatch
  malformed_source_record
}

enum MigrationImportConflictStatus {
  open
  resolved_source
  resolved_target
  resolved_manual
  ignored
}

enum PersistenceAuthority {
  local
  server
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  activeOrganizationId String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  sessions AuthSession[]
  memberships OrganizationMembership[]
  activeOrganization Organization? @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([activeOrganizationId])

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Organization {
  id          String   @id
  name        String
  industry    String
  description String
  settings    Json
  createdAt   DateTime @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  knowledgeItems      KnowledgeItem[]
  knowledgeCandidates KnowledgeCandidate[]
  validationRecords   ValidationRecord[]
  memoryChangeRecords MemoryChangeRecord[]
  ticketRecords       TicketRecord[]
  trustEvidence       TrustEvidence[]
  emergingPatterns    EmergingPattern[]
  intelligenceLogs    IntelligenceLog[]
  orgMetrics          OrgMetrics?
  ticketSequence      TicketSequence?
  migrationImportBatches    MigrationImportBatch[]
  migrationImportConflicts  MigrationImportConflict[]
  persistenceAuthority      OrganizationPersistenceAuthority?
  durableJobs              DurableJob[]
  memberships               OrganizationMembership[]
  activeUsers               User[]                   @relation("UserActiveOrganization")

  @@map("organizations")
}

model OrganizationMembership {
  userId         String
  organizationId String
  role           String   @default("member")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model KnowledgeItem {
  id                       String                  @id
  organizationId           String
  title                    String
  category                 String
  canonicalProblemId       String?
  canonicalProblemTitle    String?
  lifecycleState           KnowledgeLifecycleState @default(active)
  sourceTicketId           String
  timesReused              Int                     @default(0)
  timesSeen                Int?
  successfulResolutions    Int?
  failedResolutions        Int?
  successRate              Float?
  trustScore               Int?
  autoResponseEligible     Boolean?
  humanReviewCount         Int?
  automaticResolutionCount Int?
  createdAt                DateTime                @db.Timestamptz(6)
  approvedAt               DateTime                @db.Timestamptz(6)
  lastUsedAt               DateTime?               @db.Timestamptz(6)
  lastValidatedAt          DateTime?               @db.Timestamptz(6)
  lastUpdatedAt            DateTime?               @db.Timestamptz(6)
  lastValidated            DateTime?               @db.Timestamptz(6)
  // Optimistic concurrency control for canonical knowledge writes. Every
  // committed update must present the current revision and bumps it by one.
  revision                 Int                     @default(0)
  content                  Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, canonicalProblemId])
  @@map("knowledge_items")
}

model KnowledgeCandidate {
  id                 String                      @id
  organizationId     String
  relatedKnowledgeId String?
  sourceTicketIds    Json
  proposedAction     String
  proposedContent    Json
  rationale          String
  status             KnowledgeCandidateLifecycle @default(proposed)
  createdAt          DateTime                    @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, relatedKnowledgeId])
  @@map("knowledge_candidates")
}

model ValidationRecord {
  id                 String             @id
  organizationId     String
  candidateId        String
  knowledgeItemId    String?
  knowledgeVersionId String?
  decision           ValidationDecision
  actor              String
  actorId            String?
  roleExercised      String
  rationale          String?
  timestamp          DateTime           @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Each knowledge candidate is validated exactly once in the current domain
  // workflow; this blocks duplicate validation submissions at the database.
  @@unique([organizationId, candidateId])
  @@index([organizationId])
  @@index([organizationId, knowledgeItemId])
  @@index([organizationId, timestamp])
  @@map("validation_records")
}

/**
 * TODO-015 source-ticket trust idempotency. One row records that a given source
 * ticket has already contributed a trust-adding event to a specific KnowledgeItem.
 * The unique key makes the trust contribution idempotent: a repeated review of the
 * same ticket for the same item/event still writes ValidationRecord/MemoryChangeRecord
 * audit rows, but cannot claim a second trust delta. `delta` records the trust
 * event's delta (informational; a single validation event applies the delta once
 * even when multiple source tickets claim rows in the same event).
 */
model TrustEvidence {
  id                 String   @id @default(cuid())
  organizationId     String
  knowledgeItemId    String
  sourceTicketId     String
  trustEventType     String
  validationRecordId String
  delta              Int
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, knowledgeItemId, sourceTicketId, trustEventType])
  @@index([organizationId, knowledgeItemId])
  @@map("trust_evidence")
}

model MemoryChangeRecord {
  id                 String   @id
  organizationId     String
  knowledgeItemId    String
  candidateId        String
  validationRecordId String
  actorId            String?
  changeType         String
  beforeState        Json?
  afterState         Json
  timestamp          DateTime @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // One memory-change audit record per validation record: a retried commit can
  // never append a second before/after snapshot for the same validation.
  @@unique([organizationId, validationRecordId])
  @@index([organizationId])
  @@index([organizationId, knowledgeItemId])
  @@index([organizationId, timestamp])
  @@map("memory_change_records")
}

model TicketRecord {
  id                  String                @id @default(cuid())
  organizationId      String
  ticketId            String
  bulkUploadKey       String?
  bulkEntryId         String?
  bulkClusterId       String?
  intakeMode          String?
  rawMessage          String
  subject             String?
  status              TicketRecordLifecycle @default(open)
  draftSource         String?
  classification      Json?
  memoryMatch         Json?
  resolution          Json
  reflection          Json
  validationRecordIds Json
  actorId             String?
  // TODO-026: nullable so existing rows and unresolved tickets stay distinct
  // from a genuine human resolution. Backfill only via an approved migration.
  resolutionMode      TicketResolutionMode?
  createdAt           DateTime              @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ticketId])
  @@unique([organizationId, bulkUploadKey, bulkEntryId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("ticket_records")
}

model EmergingPattern {
  id                        String                   @id
  organizationId            String
  title                     String
  summary                   String
  category                  String
  status                    EmergingPatternLifecycle @default(monitoring)
  tags                      Json
  keywords                  Json
  exampleTickets            Json
  timesSeen                 Int
  confidenceScore           Float
  suggestedCanonicalProblem Boolean
  firstSeenAt               DateTime                 @db.Timestamptz(6)
  lastSeenAt                DateTime                 @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, lastSeenAt])
  @@map("emerging_patterns")
}

model OrgMetrics {
  organizationId             String   @id
  lifetimeTickets            Int
  knowledgeReused            Int
  autoResolutions            Int
  humanResolutions           Int
  totalResolutionTimeSec     Int
  resolutionsCount           Int
  memoryGrowthToday          Int
  memoryGrowthDate           String
  mergedTickets              Int?
  duplicatePreventions       Int?
  knowledgeVersions          Int?
  emergingPatternsDetected   Int?
  promotedPatterns           Int?
  aiCalls                    Int?
  aiSuccesses                Int?
  aiFailures                 Int?
  aiFallbacks                Int?
  aiAgreementSamples         Int?
  aiAgreementTotal           Int?
  humanAcceptedAISuggestions Int?
  lastUpdatedAt              DateTime @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_metrics")
}

model IntelligenceLog {
  id             String   @id
  organizationId String
  timestamp      DateTime @db.Timestamptz(6)
  event          String
  detail         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, timestamp])
  @@map("intelligence_log")
}

model TicketSequence {
  organizationId String   @id
  counter        Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ticket_sequences")
}

model MigrationImportBatch {
  id                    String                   @id @default(cuid())
  organizationId        String
  format                String
  formatVersion         Int
  resourcePayloadDigest String
  metadataDigest        String?
  sourceOrganizationId  String
  sourcePersistenceMode String
  sourceSchemaVersion   String
  exportedAt            DateTime                 @db.Timestamptz(6)
  counts                Json
  resourceDigests       Json
  // Immutable, validated oip-localstorage-export-v1 package retained for a
  // later Batch 5.4 import attempt. This is not arbitrary browser storage.
  packagePayload         Json?
  status                MigrationImportBatchStatus @default(pending)
  attemptCount          Int                      @default(0)
  errorSummary          String?
  createdAt             DateTime                 @default(now()) @db.Timestamptz(6)
  startedAt             DateTime?                @db.Timestamptz(6)
  completedAt           DateTime?                @db.Timestamptz(6)
  verificationCompletedAt DateTime?              @db.Timestamptz(6)
  verificationReport    Json?
  verificationError     String?
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources    MigrationImportResource[]
  conflicts    MigrationImportConflict[]
  cutovers     OrganizationPersistenceAuthority[]

  @@unique([organizationId, resourcePayloadDigest])
  @@index([organizationId, status])
  @@index([resourcePayloadDigest])
  @@map("migration_import_batches")
}

model MigrationImportResource {
  id                    String                    @id @default(cuid())
  batchId               String
  resourceType          MigrationImportResourceType
  expectedCount         Int                       @default(0)
  importedCount         Int                       @default(0)
  skippedIdenticalCount  Int                       @default(0)
  conflictCount         Int                       @default(0)
  sourceDigest           String
  targetDigest           String?
  status                MigrationImportResourceStatus @default(pending)
  attemptCount          Int                       @default(0)
  errorSummary          String?
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  startedAt             DateTime?                 @db.Timestamptz(6)
  completedAt           DateTime?                 @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(6)

  batch MigrationImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, resourceType])
  @@index([batchId, status])
  @@map("migration_import_resources")
}

model MigrationImportConflict {
  id             String                       @id @default(cuid())
  batchId        String
  organizationId String
  resourceType   MigrationImportResourceType
  fingerprint    String
  sourceRecordId String?
  conflictType   MigrationImportConflictType
  sourceDigest   String?
  targetDigest   String?
  sourceSnapshot Json?
  targetSnapshot Json?
  reason         String
  status         MigrationImportConflictStatus @default(open)
  detectedAt     DateTime                     @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime?                    @db.Timestamptz(6)
  createdAt      DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @db.Timestamptz(6)

  batch        MigrationImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([batchId, fingerprint])
  @@index([organizationId, status])
  @@index([batchId, status])
  @@map("migration_import_conflicts")
}

/**
 * Durable, organization-scoped persistence authority (TODO-004 Batch 5.8).
 * A row exists only once an organization has explicitly cut over to server
 * authority; a MISSING row resolves to `local`. The routing decision for
 * server-cutover organizations therefore lives server-side, not in one browser.
 * `migrationBatchId` binds the cutover to the exact verified MigrationImportBatch
 * that proved the organization's PostgreSQL state. localStorage is never deleted
 * by a cutover; the preserved local copy is historical rollback evidence only.
 */
model OrganizationPersistenceAuthority {
  organizationId    String                @id
  authority         PersistenceAuthority  @default(local)
  previousAuthority PersistenceAuthority?
  migrationBatchId  String?
  reason            String?
  cutoverAt         DateTime?             @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  migrationBatch MigrationImportBatch?  @relation(fields: [migrationBatchId], references: [id], onDelete: SetNull)

  @@index([authority])
  @@index([migrationBatchId])
  @@map("organization_persistence_authority")
}

// TODO-018: durable asynchronous work. Status/type/outcome stay strings so
// handlers can evolve by version without a flag-day Prisma enum migration.
model DurableJob {
  id                    String   @id @default(cuid())
  organizationId        String
  actorId               String?
  type                  String
  version               Int      @default(1)
  status                String
  priority              Int      @default(100)
  authority             String
  input                 Json
  inputDigest           String
  idempotencyKey        String
  correlationId         String
  requestId             String
  progress              Json
  progressMessage       String?
  result                Json?
  resultDigest          String?
  error                 Json?
  retryable             Boolean  @default(false)
  attemptCount          Int      @default(0)
  maxAttempts           Int      @default(3)
  nextAttemptAt         DateTime?
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  cancellationRequestedAt DateTime?
  cancelledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  deadLetteredAt        DateTime?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempts     DurableJobAttempt[]

  @@unique([organizationId, idempotencyKey])
  @@index([status, nextAttemptAt, priority, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([leaseOwner, leaseExpiresAt])
  @@map("durable_jobs")
}

model DurableJobAttempt {
  id              String   @id @default(cuid())
  jobId           String
  attemptNumber   Int
  workerId        String
  startedAt       DateTime @db.Timestamptz(6)
  heartbeatAt     DateTime? @db.Timestamptz(6)
  finishedAt      DateTime? @db.Timestamptz(6)
  outcome         String
  errorClass      String?
  retryable       Boolean?
  provider        String?
  durationMs      Int?
  safeDiagnostics Json?

  job DurableJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
  @@map("durable_job_attempts")
}
